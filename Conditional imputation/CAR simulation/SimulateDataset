m1 <- 40
m2 <- 40

##Coords
c1 <- seq(from=0, to=1, length.out=m1)
c2 <- seq(from=0, to=1, length.out=m2)
n <- m1*m2

X <- matrix(1, ncol=1, nrow=n)
p <- ncol(X)
k <- 5

beta <- matrix(c(0.1, -0.1, -0.2, 0.2), nrow=1, ncol=k-1)

nobj <- neigh_funV2(m1, m2)
A <- neig_to_A(nobj)

alpha <- 0.9
tau <- 0.1
D <- diag(as.numeric(A%*%rep(1,n)))
W <- tau * (D - alpha * A)
Sigma <- solve(W)

#Simulate spatial effects

phi <- t(mvrnorm(n = k-1, mu=rep(0, n), Sigma=Sigma))

####################
#Simulate response##
####################

mu <- X%*%beta + phi
#probs <- prob_multi(X, beta, k, phi)

probs <- multinom_logit_CAR_probs(X, beta, phi)

set.seed(895)
data <- sapply(1:n, function(i) {
  sample(1:k, size = 1, prob = probs[i, ])
})

##Plot dataset

