#Function to calculate multinomial probabilities

multinom_logit_CAR_probs <- function(X, beta, u) {
  # X: n x p design matrix
  # beta: p x (K-1) coefficient matrix
  # u: n x (K-1) matrix or vector of length n*(K-1)
  
  n <- nrow(X)
  p <- ncol(X)
  K_minus_1 <- ncol(beta)
  K <- K_minus_1 + 1
  
  # Reshape u if supplied as a vector
  if (is.vector(u)) {
    if (length(u) != n * K_minus_1) {
      stop("Length of u must be n * (K-1).")
    }
    u <- matrix(u, nrow = n, ncol = K_minus_1)
  }
  
  if (!all(dim(u) == c(n, K_minus_1))) {
    stop("u must be an n x (K-1) matrix.")
  }
  
  # Linear predictors for non-baseline categories
  eta <- X %*% beta + u   # n x (K-1)
  
  # Softmax denominator
  exp_eta <- exp(eta)
  denom <- 1 + rowSums(exp_eta)
  
  #Baseline category is category 1
  # Probabilities
  probs <- matrix(NA_real_, nrow = n, ncol = K)
  probs[, 2:K] <- exp_eta / denom
  probs[, 1] <- 1 / denom
  
  return(probs)
}


